# Kuula API — Reverse Proxy (Caddy)

# Caddy auto-provisions and auto-renews Let's Encrypt TLS certificates.
# Place this file at /opt/kuula/Caddyfile on the production host and
# uncomment the `caddy` service in docker-compose.prod.yml.

api.kuula.ug {
    # Tighten security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # Proxy all requests to the API container
    reverse_proxy api:3000 {
        # Forward real client IP + protocol
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Tighten request body size (matches Express's 256kb limit)
    request_body {
        max_size 1MB
    }

    # Log to stdout (docker logs picks it up)
    log {
        output stdout
        format json
    }
}
