# syntax=docker/dockerfile:1.7

FROM node:22-bookworm-slim AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps --no-audit --no-fund

COPY . .

ARG VITE_API_BASE_URL
ARG VITE_USE_API=true
ARG VITE_BACKEND=node
ARG VITE_APP_ENV=production
ARG VITE_REVIEWER_MODE=false
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL} \
    VITE_USE_API=${VITE_USE_API} \
    VITE_BACKEND=${VITE_BACKEND} \
    VITE_APP_ENV=${VITE_APP_ENV} \
    VITE_REVIEWER_MODE=${VITE_REVIEWER_MODE} \
    NODE_ENV=production

RUN npm run typecheck && npm run build

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /app/dist ./dist
COPY --from=build --chown=node:node /app/scripts/serve-dist.mjs ./scripts/serve-dist.mjs
USER node
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8080)+'/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "scripts/serve-dist.mjs"]
