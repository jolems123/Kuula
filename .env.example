# Kuula local development configuration.
# Copy this file to .env.local for the frontend and server/.env for the API.
# Never commit real passwords, provider keys, or production secrets.

# ── PostgreSQL database ──────────────────────────────────────────────────────
# pgAdmin 4 is the administration tool; PostgreSQL is the database service.
# Replace <PASSWORD> locally with the password assigned to the kuula database user.
DATABASE_URL="postgresql://kuula_user:<PASSWORD>@localhost:5432/kuula_db?schema=public"

# ── Node/Express authentication ─────────────────────────────────────────────
# Generate a production value with: openssl rand -hex 64
JWT_SECRET="replace-with-a-random-secret-at-least-64-characters-long"

# ── Node/Express server ──────────────────────────────────────────────────────
PORT=3000
CORS_ORIGINS="http://localhost:5000,http://localhost:5173"

# ── React/Capacitor frontend ─────────────────────────────────────────────────
VITE_BACKEND=node
VITE_USE_API=true
VITE_API_BASE_URL=http://localhost:3000
VITE_API_TIMEOUT_MS=10000
VITE_APP_ENV=development
VITE_APP_VERSION=2.4.1
VITE_ENABLE_BIOMETRIC=true
VITE_ENABLE_SAVINGS=true
VITE_REVIEWER_MODE=false
