# Kuula environment reference.
# Never commit real passwords, provider keys, production database URLs, or API secrets.
# Railway production variables belong in Railway Variables, not in this file.

# ── PostgreSQL / Railway ─────────────────────────────────────────────────────
# Local example:
DATABASE_URL="postgresql://kuula_user:<PASSWORD>@localhost:5432/kuula_db?schema=public"
# Railway API should reference the Railway Postgres service DATABASE_URL.

# ── Node/Express authentication ─────────────────────────────────────────────
# Production: generate independently with a cryptographically secure generator.
JWT_SECRET="replace-with-a-random-secret-at-least-64-characters-long"
OTP_PEPPER="replace-with-a-separate-random-secret-at-least-32-characters-long"

# ── Node/Express server ──────────────────────────────────────────────────────
PORT=3000
CORS_ORIGINS="http://localhost:5173"
# Railway production normally has one edge proxy hop. Verify req.ip in the
# deployed environment before changing this value.
TRUST_PROXY_HOPS=1

# ── SMS / MFA ────────────────────────────────────────────────────────────────
SMS_PROVIDER=africastalking
AFRICASTALKING_USERNAME=""
AFRICASTALKING_API_KEY=""
# Production startup rejects TEST_OTP_CODE and ALLOW_LOCAL_DEV_OTP=true.

# ── KYC / private evidence storage ──────────────────────────────────────────
# Production startup requires s3. Local development may use local storage.
KYC_STORAGE_PROVIDER=local
KYC_STORAGE_DIR=uploads/kyc
KYC_S3_BUCKET=""
KYC_S3_REGION=""
KYC_S3_ENDPOINT=""
KYC_S3_FORCE_PATH_STYLE=false
KYC_S3_ACCESS_KEY_ID=""
KYC_S3_SECRET_ACCESS_KEY=""
KYC_S3_KMS_KEY_ID=""

# Optional Smile ID verification
SMILE_PARTNER_ID=""
SMILE_API_KEY=""
SMILE_ENV=sandbox

# ── Mobile Money ─────────────────────────────────────────────────────────────
# SAFE DEFAULT. Keep false through the first Railway deployment and beta smoke
# tests. Switch to true only after provider credentials, callback verification,
# payment limits, reconciliation and production tests are complete.
REAL_MONEY_ENABLED=false
MARZPAY_API_KEY=""
MARZPAY_API_SECRET=""
MARZPAY_BASE_URL="https://wallet.wearemarz.com/api/v1"
PUBLIC_API_URL=""
# Do not place provider credentials in callback URLs or VITE_* variables.

# ── React/Capacitor frontend ─────────────────────────────────────────────────
VITE_BACKEND=node
VITE_USE_API=true
VITE_API_BASE_URL=http://localhost:3000
VITE_API_TIMEOUT_MS=10000
VITE_APP_ENV=development
VITE_APP_VERSION=2.4.1
VITE_ENABLE_BIOMETRIC=true
VITE_REVIEWER_MODE=false
