# ── Kuula — Environment Variables Template ──────────────────────────────────────
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# Set VITE_* vars as GitHub Secrets for CI builds, and as build environment
# variables in your hosting platform (Cloudflare Pages, Vercel, etc.).
# ───────────────────────────────────────────────────────────────────────────────

# ── Backend selection ──────────────────────────────────────────────────────────
# "supabase" = Supabase DB + Edge Functions (production)
VITE_BACKEND=supabase

# ── API mode ───────────────────────────────────────────────────────────────────
# true  = talk to real backend (Supabase)
# false = demo mode with mock data (NEVER ship to production)
VITE_USE_API=true

# ── Supabase (browser-safe values only) ────────────────────────────────────────
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT → Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=<your-sb_publishable_-anon-key>

# ── App metadata ───────────────────────────────────────────────────────────────
VITE_APP_ENV=production
VITE_APP_VERSION=2.4.1

# ── Feature flags ─────────────────────────────────────────────────────────────
VITE_ENABLE_BIOMETRIC=true
VITE_ENABLE_SAVINGS=true

# ── Store review mode ─────────────────────────────────────────────────────────
# ONLY set to true for App Store / Google Play review builds.
# MUST be false in production — auto-login bypass must never reach real users.
VITE_REVIEWER_MODE=false