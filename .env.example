# Kuula frontend / Capacitor configuration.
# Copy this file to .env.local for local frontend development.
# Server-only secrets belong in server/.env and must never be exposed through VITE_* variables.

VITE_BACKEND=node
VITE_USE_API=true
VITE_API_BASE_URL=http://localhost:3000
VITE_API_TIMEOUT_MS=10000
VITE_APP_ENV=development
VITE_APP_VERSION=2.4.1
VITE_ENABLE_BIOMETRIC=true
# Savings is intentionally unavailable until provider-settled custody, deposits,
# withdrawals, interest and statements are implemented and verified.
VITE_ENABLE_SAVINGS=false
VITE_REVIEWER_MODE=false
