# Kuula Node API configuration.
# Copy to server/.env for local development. Never commit real secrets.

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://kuula_user:<PASSWORD>@localhost:5432/kuula_db?schema=public"

# ── Authentication and OTP security ─────────────────────────────────────────
# Generate independent values with: openssl rand -hex 64
JWT_SECRET="replace-with-a-random-secret-at-least-64-characters-long"
OTP_PEPPER="replace-with-a-different-random-secret-at-least-64-characters-long"

# Production SMS provider. Kuula sends verification and password-reset codes to
# the customer's Uganda phone number; codes are stored only as keyed hashes.
SMS_PROVIDER="africastalking"
AFRICASTALKING_USERNAME=""
AFRICASTALKING_API_KEY=""
# Optional approved sender ID. Leave empty to use the provider default.
AFRICASTALKING_SENDER_ID=""

# Test only. The API refuses to start in production when this is present.
# TEST_OTP_CODE="123456"

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
CORS_ORIGINS="http://localhost:5000,http://localhost:5173"
PUBLIC_API_URL="http://localhost:3000"

# ── MarZPay mobile-money settlement ─────────────────────────────────────────
MARZPAY_API_KEY=""
MARZPAY_API_SECRET=""
MARZPAY_BASE_URL="https://wallet.wearemarz.com/api/v1"
MARZPAY_WEBHOOK_SECRET=""

# ── Seed data ───────────────────────────────────────────────────────────────
# All four values must be set before running the seed in a non-test environment.
ADMIN_EMAIL="admin-local@kuula.test"
ADMIN_PASSWORD="replace-with-a-strong-local-seed-password"
DEMO_PHONE="+256700000000"
DEMO_PASSWORD="replace-with-a-local-demo-password"

# ── KYC / identity verification ─────────────────────────────────────────────
SMILE_PARTNER_ID=""
SMILE_API_KEY=""
SMILE_ENV="sandbox"
KYC_STORAGE_DIR="uploads/kyc"
