# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (local or remote)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kuula?schema=public"

# ── Authentication ──────────────────────────────────────────────────────────
# Secret used to sign and verify JWT tokens
# Generate a strong random secret: openssl rand -hex 64
JWT_SECRET="change-me-to-a-random-secret-at-least-32-chars-long"

# ── Server ──────────────────────────────────────────────────────────────────
# Port the Express server listens on (default: 3000)
PORT=3000

# ── Seed Data ───────────────────────────────────────────────────────────────
# Admin credentials (used by seed.ts)
ADMIN_EMAIL="admin@kuula.ug"
ADMIN_PASSWORD="Admin@123456"

# Demo user credentials (used by seed.ts)
DEMO_PHONE="+256700000000"
DEMO_PASSWORD="12345678"

