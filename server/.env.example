# Kuula Node API configuration.
# Copy to server/.env for local development. Never commit real secrets.

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://kuula_user:<PASSWORD>@localhost:5432/kuula_db?schema=public"

# ── Authentication and OTP security ─────────────────────────────────────────
# Generate independent production values with: openssl rand -hex 64
JWT_SECRET="replace-with-a-random-secret-at-least-64-characters-long"
OTP_PEPPER="replace-with-a-different-random-secret-at-least-64-characters-long"

# Production SMS provider. Kuula sends verification and password-reset codes to
# the customer's Uganda phone number; codes are stored only as keyed hashes.
SMS_PROVIDER="africastalking"
AFRICASTALKING_USERNAME=""
AFRICASTALKING_API_KEY=""
AFRICASTALKING_SENDER_ID=""
AFRICASTALKING_USSD_SERVICE_CODE="*384*52792#"

# ── Transactional email / Hostinger ─────────────────────────────────────────
# Production sender: notifications@kuulapp.com
# Store SMTP_PASSWORD only in the deployment secret store (e.g. Railway).
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_USER="notifications@kuulapp.com"
SMTP_PASSWORD=""
EMAIL_FROM="notifications@kuulapp.com"
EMAIL_FROM_NAME="Kuula"
SUPPORT_EMAIL="support@kuulapp.com"
LOANS_EMAIL="loans@kuulapp.com"
PAYMENTS_EMAIL="payments@kuulapp.com"
KYC_EMAIL="kyc@kuulapp.com"
COMPLAINTS_EMAIL="complaints@kuulapp.com"
PRIVACY_EMAIL="privacy@kuulapp.com"
PARTNERS_EMAIL="partners@kuulapp.com"
COLLECTIONS_EMAIL="collections@kuulapp.com"
FINANCE_EMAIL="finance@kuulapp.com"
COMPLIANCE_EMAIL="compliance@kuulapp.com"
FRAUD_EMAIL="fraud@kuulapp.com"
SECURITY_EMAIL="security@kuulapp.com"
LEGAL_EMAIL="legal@kuulapp.com"

# Local/test only. Production startup rejects both settings.
# TEST_OTP_CODE="123456"
# ALLOW_LOCAL_DEV_OTP="true"

# ── Server / proxy ──────────────────────────────────────────────────────────
PORT=3000
CORS_ORIGINS="http://localhost:5000,http://localhost:5173"
PUBLIC_API_URL="http://localhost:3000"
TRUST_PROXY_HOPS=1

# ── Real-money switch ───────────────────────────────────────────────────────
REAL_MONEY_ENABLED=false

# ── MarZPay mobile-money settlement ─────────────────────────────────────────
MARZPAY_API_KEY=""
MARZPAY_API_SECRET=""
MARZPAY_BASE_URL="https://wallet.wearemarz.com/api/v1"
MARZPAY_WEBHOOK_SECRET=""
MARZPAY_WEBHOOK_SIGNATURE_SECRET=""
MARZPAY_ALLOW_QUERY_WEBHOOK_TOKEN=false

# ── Seed data ───────────────────────────────────────────────────────────────
ADMIN_EMAIL="admin-local@kuula.test"
ADMIN_PASSWORD="replace-with-a-strong-local-seed-password"
DEMO_PHONE="+256700000000"
DEMO_PASSWORD="replace-with-a-local-demo-password"

# ── KYC / identity verification ─────────────────────────────────────────────
SMILE_PARTNER_ID=""
SMILE_API_KEY=""
SMILE_ENV="sandbox"
KYC_STORAGE_DIR="uploads/kyc"
KYC_STORAGE_PROVIDER="local"
KYC_S3_BUCKET=""
KYC_S3_REGION=""
KYC_S3_ENDPOINT=""
KYC_S3_ACCESS_KEY_ID=""
KYC_S3_SECRET_ACCESS_KEY=""
KYC_S3_KMS_KEY_ID=""
KYC_S3_FORCE_PATH_STYLE=false

# Railway production minimums additionally include:
# NODE_ENV=production
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=notifications@kuulapp.com
# SMTP_PASSWORD=<Hostinger mailbox password stored as a Railway secret>
# EMAIL_FROM=notifications@kuulapp.com
# SUPPORT_EMAIL=support@kuulapp.com
# COMPLAINTS_EMAIL=complaints@kuulapp.com
# PRIVACY_EMAIL=privacy@kuulapp.com
