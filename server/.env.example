# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (local or remote)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kuula?schema=public"

# ── Authentication ──────────────────────────────────────────────────────────
# Secret used to sign and verify JWT tokens
# Generate a strong random secret: openssl rand -hex 64
JWT_SECRET="change-me-to-a-random-secret-at-least-32-chars-long"

# Access tokens are short-lived and held in memory by the client; long-lived
# authority is a rotating opaque refresh token stored hashed in the database.
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
# Set for the web app's httpOnly refresh cookie. Leave blank for host-only.
SESSION_COOKIE_DOMAIN=""
# Forced on in production regardless of this value.
SESSION_COOKIE_SECURE="false"

# ── Server ──────────────────────────────────────────────────────────────────
# Port the Express server listens on (default: 3000)
PORT=3000

# Publicly reachable https base URL. MarzPay POSTs payment callbacks to
# {PUBLIC_API_BASE_URL}/api/webhooks/marzpay, so this MUST be reachable from the
# internet — the server refuses to start in production without it.
PUBLIC_API_BASE_URL=""

# ── Payments: MarzPay (REQUIRED in production) ──────────────────────────────
# Kuula moves real money through MarzPay. Without these the disbursement and
# repayment endpoints return 503 — they never fall back to a simulated wallet.
MARZPAY_BASE_URL="https://wallet.wearemarz.com/api/v1"
MARZPAY_API_KEY=""
MARZPAY_API_SECRET=""

# Shared secret used to authenticate incoming payment callbacks.
# The webhook is the ONLY place money is settled, so it fails closed: with no
# secret set it rejects every callback with 503.
MARZPAY_WEBHOOK_SECRET=""
# "hmac" (preferred): HMAC-SHA256 over "<timestamp>.<raw body>", sent as
#   X-Marzpay-Signature with X-Marzpay-Timestamp, constant-time compared and
#   rejected outside the tolerance window below.
# "token" (legacy): shared bearer secret in ?token= or X-Webhook-Token.
#   Accepted only where HMAC is not yet provisioned; blocked in production.
MARZPAY_WEBHOOK_MODE="hmac"
MARZPAY_WEBHOOK_TOLERANCE_SEC=300

# When true (default) the server independently re-queries MarzPay for a
# transaction's real status before settling, instead of trusting the callback
# body's success field. Leave this on.
MARZPAY_VERIFY_CALLBACKS="true"
MARZPAY_TIMEOUT_MS=20000

# ── SMS / OTP (REQUIRED in production) ──────────────────────────────────────
# "egosms" for real delivery, or "log" for local development only.
# The server refuses to start in production with "log" — OTPs must never be
# printed instead of sent.
SMS_PROVIDER="log"
SMS_USERNAME=""
SMS_PASSWORD=""
SMS_SENDER_ID="KUULA"
SMS_BASE_URL=""
SMS_TIMEOUT_MS=15000

# OTPs are stored as HMAC-SHA256(code, OTP_PEPPER) — never in plaintext.
# Generate with: openssl rand -hex 32
OTP_PEPPER=""
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5

# ── Seed Data ───────────────────────────────────────────────────────────────
# Admin credentials (used by seed.ts)
ADMIN_EMAIL="admin@kuula.ug"
ADMIN_PASSWORD="Admin@123456"

# Demo user credentials (used by seed.ts)
DEMO_PHONE="+256700000000"
DEMO_PASSWORD="12345678"

# ── KYC / Identity Verification (Smile ID) ──────────────────────────────────
# Optional. When both SMILE_PARTNER_ID and SMILE_API_KEY are set, KYC submits
# are verified against NIRA via Smile ID Enhanced KYC. If unset, KYC records
# fall back to "pending" for manual review (fail-safe — never blocks the user).
SMILE_PARTNER_ID=""
SMILE_API_KEY=""
# "sandbox" (default) or "production"
SMILE_ENV="sandbox"

# ── KYC document storage ────────────────────────────────────────────────────
# Directory where uploaded ID images are written (relative to the server's
# working dir, or an absolute path). Git-ignored. Swap the storage.ts
# implementation for object storage (S3 / Supabase Storage) in production.
KYC_STORAGE_DIR="uploads/kyc"

