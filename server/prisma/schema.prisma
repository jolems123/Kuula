generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  role           String    @default("user")
  fullName       String    @default("") @map("full_name")
  phone          String?   @unique
  email          String?   @unique
  nationalId     String?   @unique @map("national_id")
  dateOfBirth    DateTime? @map("date_of_birth")
  district       String?   @default("")
  occupation     String?   @default("")
  verified       Boolean   @default(false)
  momoMonths     Int       @default(0) @map("momo_months")
  momoTxnCount   Int       @default(0) @map("momo_txn_count")
  crbStatus      String    @default("thin") @map("crb_status")
  kycVerified    Boolean   @default(false) @map("kyc_verified")
  kycDocFrontRef String?   @map("kyc_doc_front_ref")
  kycDocBackRef  String?   @map("kyc_doc_back_ref")
  kycProvider    String?   @map("kyc_provider")
  kycReference   String?   @map("kyc_reference")
  kycSubmittedAt DateTime? @map("kyc_submitted_at")
  loansTotal     Int       @default(0) @map("loans_total")
  loansRepaid    Int       @default(0) @map("loans_repaid")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  passwordHash   String?  @map("password_hash")
  phoneVerified  Boolean  @default(false) @map("phone_verified")
  authVersion    Int      @default(0) @map("auth_version")

  otpHash        String?   @map("otp_hash")
  otpPurpose     String?   @map("otp_purpose")
  otpExpiresAt   DateTime? @map("otp_expires_at")
  otpAttempts    Int       @default(0) @map("otp_attempts")
  otpLastSentAt  DateTime? @map("otp_last_sent_at")
  otpLockedUntil DateTime? @map("otp_locked_until")

  termsAcceptedAt DateTime? @map("terms_accepted_at")
  termsVersion    String?   @map("terms_version")

  savingsAccount           SavingsAccount?
  wallet                   Wallet?
  sentMessages             Message[]                    @relation("sender")
  receivedMessages         Message[]                    @relation("receiver")
  loanApplications         LoanApplication[]
  repayments               Repayment[]
  transactions             Transaction[]
  savingsGoals             SavingsGoal[]
  notifications            Notification[]
  authSessions             AuthSession[]
  creditEvidence           CreditEvidence[]
  kycSubmissions           KycSubmission[]
  underwritingAssessments  UnderwritingAssessment[]
  agreementAcceptances     LoanAgreementAcceptance[]
  growthLine               GrowthLine?
  creditPassSnapshots      CreditPassSnapshot[]
  partnerFinancingRequests PartnerFinancingRequest[]

  @@map("users")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model CreditEvidence {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  sourceType        String    @map("source_type")
  provider          String
  externalReference String    @map("external_reference")
  momoMonths        Int?      @map("momo_months")
  momoTxnCount      Int?      @map("momo_txn_count")
  crbStatus         String?   @map("crb_status")
  payload           Json?
  observedAt        DateTime  @map("observed_at")
  expiresAt         DateTime  @map("expires_at")
  status            String    @default("verified")
  verifiedBy        String?   @map("verified_by") @db.Uuid
  revokedAt         DateTime? @map("revoked_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, externalReference])
  @@index([userId, sourceType, status, expiresAt])
  @@map("credit_evidence")
}

model KycSubmission {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  version           Int
  status            String    @default("pending")
  fullName          String    @map("full_name")
  nationalId        String    @map("national_id")
  dateOfBirth       DateTime  @map("date_of_birth")
  frontRef          String    @map("front_ref")
  backRef           String    @map("back_ref")
  frontMime         String    @map("front_mime")
  backMime          String    @map("back_mime")
  provider          String?
  providerReference String?   @map("provider_reference")
  providerStatus    String?   @map("provider_status")
  providerDetail    String?   @map("provider_detail")
  submittedAt       DateTime  @default(now()) @map("submitted_at")
  reviewedAt        DateTime? @map("reviewed_at")
  reviewedBy        String?   @map("reviewed_by") @db.Uuid
  decisionReason    String?   @map("decision_reason")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, version])
  @@index([status, submittedAt])
  @@index([nationalId])
  @@map("kyc_submissions")
}

model KycAuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  submissionId String   @map("submission_id") @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  action       String
  details      Json?
  createdAt    DateTime @default(now()) @map("created_at")
  @@index([submissionId, createdAt])
  @@index([actorId, createdAt])
  @@map("kyc_audit_events")
}

model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String?  @map("actor_id") @db.Uuid
  subjectUserId String?  @map("subject_user_id") @db.Uuid
  action        String
  resourceType  String   @map("resource_type")
  resourceId    String?  @map("resource_id")
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")
  @@index([actorId, createdAt])
  @@index([subjectUserId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_events")
}

model SavingsAccount {
  userId    String   @id @map("user_id") @db.Uuid
  balance   BigInt   @default(0)
  updatedAt DateTime @default(now()) @map("updated_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("savings_accounts")
}

model Wallet {
  userId  String @id @map("user_id") @db.Uuid
  balance BigInt @default(0)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("wallets")
}

model Message {
  id         String   @id @default(uuid()) @db.Uuid
  senderId   String   @map("sender_id") @db.Uuid
  receiverId String   @map("receiver_id") @db.Uuid
  content    String
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")
  sender   User @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  @@index([senderId, receiverId, createdAt])
  @@map("messages")
}

model LoanApplication {
  id                  String    @id @default(uuid()) @db.Uuid
  applicantId         String    @map("applicant_id") @db.Uuid
  applicantName       String    @default("") @map("applicant_name")
  amount              BigInt
  purpose             String    @default("Personal")
  termDays            Int       @default(90) @map("term_days")
  channel             String    @default("MTN MoMo")
  apr                 Decimal   @default(0.336) @db.Decimal(5, 4)
  interest            BigInt    @default(0)
  total               BigInt    @default(0)
  interestRate        Decimal   @default(0.26) @map("interest_rate") @db.Decimal(5, 4)
  serviceFeeRate      Decimal   @default(0.10) @map("service_fee_rate") @db.Decimal(5, 4)
  serviceFee          BigInt    @default(0) @map("service_fee")
  disbursementMethod  String    @default("mtn_momo") @map("disbursement_method")
  approvedBy          String?   @map("approved_by") @db.Uuid
  dueDate             DateTime? @map("due_date")
  status              String    @default("pending")
  disbursementRef     String?   @map("disbursement_ref")
  loanId              String?   @map("loan_id")
  decisionNotes       String?   @map("decision_notes")
  acceptedAt          DateTime? @map("accepted_at")
  offerExpiresAt      DateTime? @map("offer_expires_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  decidedAt           DateTime? @map("decided_at")
  applicant User @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  underwriting UnderwritingAssessment?
  agreementAcceptance LoanAgreementAcceptance?
  partnerFinancing PartnerFinancingRequest?
  @@index([applicantId, createdAt(sort: Desc)])
  @@index([status])
  @@index([loanId])
  @@index([offerExpiresAt])
  @@map("loan_applications")
}

model UnderwritingAssessment {
  id                      String   @id @default(uuid()) @db.Uuid
  applicationId           String   @unique @map("application_id") @db.Uuid
  userId                  String   @map("user_id") @db.Uuid
  declaredMonthlyIncome   BigInt   @map("declared_monthly_income")
  declaredMonthlyExpenses BigInt   @map("declared_monthly_expenses")
  existingDebtPayment     BigInt   @default(0) @map("existing_debt_payment")
  verifiedMonthlyIncome   BigInt?  @map("verified_monthly_income")
  disposableIncome        BigInt   @map("disposable_income")
  maxAffordablePayment    BigInt   @map("max_affordable_payment")
  creditScore             Int      @map("credit_score")
  approvedLimit           BigInt   @map("approved_limit")
  status                  String
  flags                   Json     @default("[]")
  assessedAt              DateTime @default(now()) @map("assessed_at")
  assessedBy              String?  @map("assessed_by") @db.Uuid
  application LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, assessedAt])
  @@index([status])
  @@map("underwriting_assessments")
}

model LoanAgreementAcceptance {
  id               String   @id @default(uuid()) @db.Uuid
  applicationId    String   @unique @map("application_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  agreementVersion String   @map("agreement_version")
  agreementHash    String   @map("agreement_hash")
  termsSnapshot    Json     @map("terms_snapshot")
  clientContext    Json?    @map("client_context")
  acceptedAt       DateTime @default(now()) @map("accepted_at")
  application LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, acceptedAt])
  @@map("loan_agreement_acceptances")
}

model Repayment {
  id                   String   @id @default(uuid()) @db.Uuid
  loanId               String   @map("loan_id")
  userId               String   @map("user_id") @db.Uuid
  total                BigInt
  amountPaid           BigInt   @default(0) @map("amount_paid")
  dueDate              DateTime @map("due_date")
  status               String   @default("scheduled")
  receiptId            String?  @map("receipt_id")
  pendingCollectionRef String?  @unique @map("pending_collection_ref")
  attempts             Json     @default("[]")
  createdAt            DateTime @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([loanId])
  @@index([status])
  @@index([userId, status, dueDate])
  @@map("repayments")
}

model Transaction {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  loanId               String?   @map("loan_id")
  type                  String
  amount                BigInt
  status                String    @default("pending")
  reference             String?   @unique
  provider              String?
  providerStatus        String?   @map("provider_status")
  providerPayload       Json?     @map("provider_payload")
  providerAmount        BigInt?   @map("provider_amount")
  providerCurrency      String?   @map("provider_currency")
  transactionId         String?   @map("transaction_id")
  reconciliationStatus  String    @default("unreconciled") @map("reconciliation_status")
  reconciledAt          DateTime? @map("reconciled_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  journal Journal?
  @@index([userId, createdAt(sort: Desc)])
  @@index([loanId])
  @@index([transactionId])
  @@index([status])
  @@index([status, createdAt])
  @@index([reconciliationStatus, createdAt])
  @@map("transactions")
}

model Journal {
  id            String   @id @default(uuid()) @db.Uuid
  transactionId String   @unique @map("transaction_id") @db.Uuid
  reference     String   @unique
  description   String
  postedAt      DateTime @default(now()) @map("posted_at")
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  entries JournalEntry[]
  @@index([postedAt])
  @@map("journals")
}

model JournalEntry {
  id          String   @id @default(uuid()) @db.Uuid
  journalId   String   @map("journal_id") @db.Uuid
  accountCode String   @map("account_code")
  direction   String
  amount      BigInt
  userId      String?  @map("user_id") @db.Uuid
  loanId      String?  @map("loan_id")
  createdAt   DateTime @default(now()) @map("created_at")
  journal Journal @relation(fields: [journalId], references: [id], onDelete: Restrict)
  @@index([journalId])
  @@index([accountCode, createdAt])
  @@index([userId, createdAt])
  @@index([loanId])
  @@map("journal_entries")
}

model SavingsGoal {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  emoji     String   @default("🎯")
  target    BigInt
  saved     BigInt   @default(0)
  color     String   @default("#2563EB")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@map("savings_goals")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String
  body      String
  type      String   @default("info")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isRead])
  @@map("notifications")
}

model Market {
  code          String   @id
  countryName   String   @map("country_name")
  currency      String
  dialingCode   String   @map("dialing_code")
  defaultLocale String   @default("en") @map("default_locale")
  status        String   @default("planned")
  config        Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  products      CreditProduct[]
  partners      Partner[]
  growthLines   GrowthLine[]
  creditPasses  CreditPassSnapshot[]
  financingRequests PartnerFinancingRequest[]
  @@map("markets")
}

model CreditProduct {
  id                String  @id @default(uuid()) @db.Uuid
  code              String  @unique
  marketCode        String  @map("market_code")
  name              String
  category          String
  purposeType       String  @map("purpose_type")
  description       String
  minAmount         BigInt  @map("min_amount")
  maxAmount         BigInt  @map("max_amount")
  minTermDays       Int     @map("min_term_days")
  maxTermDays       Int     @map("max_term_days")
  disbursementMode  String  @map("disbursement_mode")
  partnerRequired   Boolean @default(false) @map("partner_required")
  status            String  @default("active")
  metadata          Json    @default("{}")
  market Market @relation(fields: [marketCode], references: [code], onDelete: Restrict)
  financingRequests PartnerFinancingRequest[]
  @@index([marketCode, status])
  @@index([category, status])
  @@map("credit_products")
}

model GrowthLine {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid
  marketCode         String   @map("market_code")
  totalLimit         BigInt   @default(0) @map("total_limit")
  availableLimit     BigInt   @default(0) @map("available_limit")
  status             String   @default("building")
  sourceAssessmentId String?  @map("source_assessment_id") @db.Uuid
  reviewedAt         DateTime @default(now()) @map("reviewed_at")
  expiresAt          DateTime @map("expires_at")
  rationale          Json     @default("{}")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  market Market @relation(fields: [marketCode], references: [code], onDelete: Restrict)
  @@index([marketCode, status])
  @@index([expiresAt])
  @@map("growth_lines")
}

model CreditPassSnapshot {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  marketCode     String   @map("market_code")
  score          Int
  tier           String
  kycLevel       String   @map("kyc_level")
  repaymentRate  Decimal  @default(0) @map("repayment_rate") @db.Decimal(5, 2)
  availableLimit BigInt   @default(0) @map("available_limit")
  signals        Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  market Market @relation(fields: [marketCode], references: [code], onDelete: Restrict)
  @@index([userId, createdAt(sort: Desc)])
  @@index([marketCode, createdAt(sort: Desc)])
  @@map("credit_pass_snapshots")
}

model Partner {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique
  marketCode     String   @map("market_code")
  name           String
  partnerType    String   @map("partner_type")
  status         String   @default("active")
  settlementMode String   @default("direct_payee") @map("settlement_mode")
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  market Market @relation(fields: [marketCode], references: [code], onDelete: Restrict)
  locations PartnerLocation[]
  financingRequests PartnerFinancingRequest[]
  @@index([marketCode, partnerType, status])
  @@map("partners")
}

model PartnerLocation {
  id                String   @id @default(uuid()) @db.Uuid
  partnerId         String   @map("partner_id") @db.Uuid
  name              String
  district          String?
  country           String
  phone             String?
  externalReference String?  @map("external_reference")
  active            Boolean  @default(true)
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now()) @map("created_at")
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  financingRequests PartnerFinancingRequest[]
  @@index([partnerId, active])
  @@index([district, active])
  @@map("partner_locations")
}

model PartnerFinancingRequest {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  marketCode        String   @map("market_code")
  partnerId         String   @map("partner_id") @db.Uuid
  partnerLocationId String?  @map("partner_location_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  externalReference String?  @unique @map("external_reference")
  invoiceReference  String?  @map("invoice_reference")
  purpose           String
  amount            BigInt
  status            String   @default("submitted")
  payeeName         String   @map("payee_name")
  payeeReference    String?  @map("payee_reference")
  loanApplicationId String?  @unique @map("loan_application_id") @db.Uuid
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  market Market @relation(fields: [marketCode], references: [code], onDelete: Restrict)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  partnerLocation PartnerLocation? @relation(fields: [partnerLocationId], references: [id], onDelete: Restrict)
  product CreditProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  loanApplication LoanApplication? @relation(fields: [loanApplicationId], references: [id], onDelete: Restrict)
  @@index([userId, createdAt(sort: Desc)])
  @@index([partnerId, status, createdAt])
  @@index([marketCode, status])
  @@map("partner_financing_requests")
}
