# Copy to server/.env.test to run the backend test suite.
#
#   createdb kuula_test
#   cp .env.test.example .env.test
#   npx prisma migrate deploy      # with DATABASE_URL pointing at kuula_test
#   npm test
#
# The suite refuses to run unless the database name ends in _test, because it
# truncates every table between cases.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kuula_test"
NODE_ENV=test

JWT_SECRET="test-secret-that-is-at-least-32-characters-long-xx"
OTP_PEPPER="test-pepper-that-is-at-least-32-characters-long-x"

# Captures OTPs in an in-memory outbox instead of sending them. Production
# refuses to boot with this driver.
SMS_PROVIDER="log"

# Credentials only need to be present — the provider's HTTP boundary is stubbed.
MARZPAY_API_KEY="test-key"
MARZPAY_API_SECRET="test-secret"
MARZPAY_WEBHOOK_SECRET="test-webhook-secret"
MARZPAY_WEBHOOK_MODE="hmac"

# Off in tests so callbacks exercise the parsing/matching path directly rather
# than the outbound status re-query. Both paths are covered.
MARZPAY_VERIFY_CALLBACKS="false"
PUBLIC_API_BASE_URL="https://test.kuula.local"
