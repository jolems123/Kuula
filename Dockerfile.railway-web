# syntax=docker/dockerfile:1.7

FROM node:22-bookworm-slim AS build
WORKDIR /app

RUN npm install --global npm@10.9.2 \
    && test "$(npm --version)" = "10.9.2"

COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps --no-audit --no-fund

COPY . .
ENV VITE_BACKEND=node \
    VITE_USE_API=true \
    VITE_APP_ENV=production \
    VITE_API_BASE_URL=https://api.kuulapp.com \
    VITE_REVIEWER_MODE=false
RUN npm run build:web \
    && npm prune --omit=dev

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app

COPY --from=build --chown=node:node /app/package.json ./
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/scripts/serve-web.mjs ./scripts/serve-web.mjs
COPY --from=build --chown=node:node /app/dist ./dist

USER node
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:' + (process.env.PORT || '3000') + '/health').then(r => { if (!r.ok) process.exit(1) }).catch(() => process.exit(1))"

CMD ["node", "scripts/serve-web.mjs"]
