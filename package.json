{
  "name": "kuula-mobile",
  "private": true,
  "version": "2.4.1",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20 <23",
    "npm": "10.9.2"
  },
  "scripts": {
    "dev": "vite",
    "check:env": "node scripts/check-env.mjs",
    "sync:app-id": "node scripts/sync-native-app-id.mjs",
    "prebuild": "node scripts/check-env.mjs && node scripts/sync-native-app-id.mjs",
    "build": "vite build",
    "build:web": "node scripts/check-env.mjs && vite build",
    "serve:web": "node scripts/serve-web.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sweep": "node scripts/route-sweep.mjs",
    "check:pricing": "node scripts/check-pricing-compliance.mjs",
    "check:brand": "node scripts/check-brand.mjs",
    "check:pricing-parity": "tsx scripts/check-pricing-parity.ts",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@supabase/supabase-js": "^2.108.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "^17.0.8",
    "react-router": "^7.17.0",
    "recharts": "2.15.2",
    "tw-animate-css": "^1.3.8",
    "uuid": "^14.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@prisma/client": "^5.22.0",
    "@tailwindcss/vite": "4.1.12",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "4.7.0",
    "playwright": "^1.56.1",
    "prisma": "^5.22.0",
    "tailwindcss": "4.1.12",
    "tsx": "^4.23.1",
    "typescript": "~5.8.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.9"
  }
}
