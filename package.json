{
  "name": "kuula-mobile",
  "private": true,
  "version": "2.4.1",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20 <23",
    "npm": "10.9.2"
  },
  "scripts": {
    "dev": "vite",
    "check:env": "node scripts/check-env.mjs",
    "check:api": "node scripts/check-api.mjs",
    "sync:app-id": "node scripts/sync-native-app-id.mjs",
    "prebuild": "node scripts/check-env.mjs && node scripts/sync-native-app-id.mjs",
    "build": "vite build",
    "build:web": "node scripts/check-env.mjs && vite build",
    "serve:web": "node scripts/serve-web.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sweep": "node scripts/route-sweep.mjs",
    "check:pricing": "node scripts/check-pricing-compliance.mjs",
    "check:brand": "node scripts/check-brand.mjs",
    "check:pricing-parity": "tsx scripts/check-pricing-parity.ts",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.117.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "docx": "^9.13.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "i18next": "^26.5.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "^17.1.3",
    "react-router": "^8.5.0",
    "recharts": "3.10.1",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "react-is": "19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@prisma/client": "^5.22.0",
    "@tailwindcss/vite": "4.1.12",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "4.7.0",
    "playwright": "^1.56.1",
    "prisma": "^5.22.0",
    "tailwindcss": "4.1.12",
    "tsx": "^4.23.1",
    "typescript": "~5.8.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.12",
    "brace-expansion": "^5.0.12",
    "browserslist": "^4.28.7",
    "source-map-js": "^1.2.2",
    "baseline-browser-mapping": "^2.11.0",
    "body-parser": "^2.4.0"
  }
}
